.orquesta-runtime/
.worktrees/
.ssl-key.log
*.log
bin/
dist/
coverage.out
tmp/
runtime/
var/

# Herramientas, copias y fuentes de referencia que pueden contener datos
# personales o tener un historial Git independiente. Se conservan en el puesto
# de trabajo, pero nunca deben entrar en este repositorio.
/Baremador/
/Bolsa_Diputacion/
/Bolsa_Diputacion_app/
/cegid_peoplenet_aapp/
/convoca_dipgra/
/fotos/
/Peticion.pdf

# Los resúmenes comparativos sí se versionan; los manuales originales se
# conservan como fuentes locales para evitar binarios pesados en Git.
/docs/referencias_portales_aapp/manuales/

# Catálogo RPT generado desde una fuente local. Debe regenerarse o montarse
# expresamente en cada entorno; no se distribuye dentro del repositorio.
/config/rpt_positions_import.json

# Datos geograficos derivados: se regeneran siguiendo deploy/osrm-granada/README.md.
/deploy/osrm-granada/data/

# Cachés locales.
__pycache__/
*.py[cod]

# Material criptografico. El repositorio es publico: no entra ninguna clave ni
# certificado, tampoco los de pega del perfil `desarrollo` (T21/DEC-093). Un
# certificado en el historico publico es un hallazgo aunque no valga nada.
*.pem
*.key
*.crt
*.csr
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
/deploy/desarrollo/credenciales/

# Rutas locales exactas de defensa en profundidad para T21. El generador
# rechaza escribir dentro del repositorio, aunque una ruta este ignorada.
/.vec-desarrollo/
/config/desarrollo.local.env
/config/desarrollo.local/
/scripts/.credenciales-desarrollo/
# Credenciales de autenticacion HTTP de despliegue.
.htpasswd
*.htpasswd
