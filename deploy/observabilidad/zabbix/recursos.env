# Presupuesto de recursos de la capa de supervisión (M0). Fuente única: el
# piloto (scripts/probar_presupuesto_supervision.sh) aplica estos valores y
# comprueba en modo «coherencia» que las unidades Quadlet usan los mismos.
# Formato shell: VARIABLE=valor, sin espacios.

# Peso de CPU relativo (cpu.weight ~10 frente a 100 de un servicio normal):
# ante contención, VEC y su PostgreSQL ganan siempre.
CUOTA_CPU_RELATIVA=256

# PostgreSQL propio de supervisión.
PG_CPUS=1.0
PG_MEMORIA=768m
PG_PIDS=128
# Servidor Zabbix.
SERVIDOR_CPUS=1.0
SERVIDOR_MEMORIA=384m
SERVIDOR_PIDS=256
# Frontend (solo interno, mantenimiento y API para Administración).
WEB_CPUS=0.5
WEB_MEMORIA=256m
WEB_PIDS=64
# Agente 2 (host + cgroups por lectura de ficheros, sin socket del motor).
AGENTE_CPUS=0.25
AGENTE_MEMORIA=128m
AGENTE_PIDS=64

# Límite de E/S del PostgreSQL de supervisión. Solo se aplica si el
# controlador «io» está delegado al usuario (ver README, «rootless»).
PG_ESCRITURA_BPS=20mb
PG_LECTURA_BPS=50mb

# Ajuste de PostgreSQL para una base pequeña de supervisión.
PG_AJUSTES="-c shared_buffers=128MB -c effective_cache_size=256MB -c work_mem=4MB -c maintenance_work_mem=32MB -c max_connections=60 -c wal_buffers=4MB -c max_wal_size=512MB -c min_wal_size=64MB -c checkpoint_completion_target=0.9 -c synchronous_commit=off -c autovacuum_max_workers=2 -c random_page_cost=1.1 -c jit=off"

# Ajuste del servidor Zabbix: solo agentes activos, pocos procesos y cachés
# pequeñas. ZBX_ALLOWSOFTWAREUPDATECHECK=0: ninguna llamada saliente a zabbix.com.
SERVIDOR_AJUSTES="ZBX_STARTPOLLERS=1 ZBX_STARTPOLLERSUNREACHABLE=1 ZBX_STARTAGENTPOLLERS=1 ZBX_STARTHTTPAGENTPOLLERS=1 ZBX_STARTSNMPPOLLERS=1 ZBX_STARTHTTPPOLLERS=1 ZBX_STARTTRAPPERS=3 ZBX_STARTPINGERS=1 ZBX_STARTDISCOVERERS=1 ZBX_STARTDBSYNCERS=2 ZBX_STARTLLDPROCESSORS=1 ZBX_STARTPREPROCESSORS=2 ZBX_STARTALERTERS=1 ZBX_STARTESCALATORS=1 ZBX_STARTTIMERS=1 ZBX_CACHESIZE=32M ZBX_HISTORYCACHESIZE=16M ZBX_HISTORYINDEXCACHESIZE=4M ZBX_TRENDCACHESIZE=4M ZBX_TRENDFUNCTIONCACHESIZE=4M ZBX_VALUECACHESIZE=32M ZBX_ALLOWSOFTWAREUPDATECHECK=0 ZBX_ENABLEGLOBALSCRIPTS=0"

# PHP-FPM del frontend: uso esporádico de mantenimiento y consultas de API.
WEB_AJUSTES="PHP_FPM_PM=ondemand PHP_FPM_PM_MAX_CHILDREN=4 PHP_FPM_PM_START_SERVERS=1 PHP_FPM_PM_MIN_SPARE_SERVERS=1 PHP_FPM_PM_MAX_SPARE_SERVERS=2 PHP_FPM_PM_MAX_REQUESTS=500 ZBX_MEMORYLIMIT=128M PHP_TZ=Europe/Madrid"
