[Unit]
Description=Consulta pública anónima de VEC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vec-publico
Group=vec-publico
WorkingDirectory=/opt/vec/publico
ExecStart=/usr/bin/python3 /opt/vec/publico/deploy/publico/runtime.py start --config /etc/vec/publico/runtime.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
