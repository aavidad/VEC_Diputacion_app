# Puerto accesible exclusivamente desde el anfitrion. El proxy inverso es el
# unico consumidor autorizado en la primera fase.
OSM_TILES_PORT=8091

# Limites iniciales prudentes para un extracto provincial. Sistemas debe
# ajustarlos con mediciones antes de produccion, no eliminarlos.
OSM_TILES_MEMORY=1g
OSM_TILES_CPUS=1.0
OSM_PROXY_MEMORY=128m
OSM_PROXY_CPUS=0.25
OSM_IMPORT_MEMORY=3g
OSM_IMPORT_CPUS=2.0

# El PBF compartido actual no declara bbox en su cabecera. Este rectangulo
# cubre Granada y su margen de enrutado; toda modificacion debe versionarse.
OSM_IMPORT_BBOX=-4.75,36.55,-1.75,38.25
