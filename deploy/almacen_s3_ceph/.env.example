# Copiar a un gestor de secretos o exportar en la sesion. No confirmar valores reales.
VEC_CEPH_INTEGRACION=1
VEC_CEPH_ENDPOINT=https://rgw.almacen.interno.example
VEC_CEPH_REGION=eu-west-1
VEC_CEPH_BUCKET_CUARENTENA=vec-cuarentena-pruebas
VEC_CEPH_BUCKET_ADMITIDA=vec-admitida-pruebas
VEC_CEPH_ACCESS_KEY_ID=
VEC_CEPH_SECRET_ACCESS_KEY=
VEC_CEPH_SESSION_TOKEN=
VEC_CEPH_RUTA_CA=/etc/vec/pki/ca-almacen.pem
# CIDR exactos a los que puede conectarse el proceso. No usar 0.0.0.0/0 ni ::/0.
VEC_CEPH_REDES_PERMITIDAS=10.20.30.0/24
VEC_CEPH_PATH_STYLE=true
VEC_CEPH_TAMANO_MAXIMO_BYTES=268435456
VEC_CEPH_DURACION_CARGA_DIRECTA=5m
VEC_CEPH_RETENCION_MINIMA_ADMITIDA=1h
# Exactamente 32 bytes codificados como base64url sin relleno. Generar y custodiar en un gestor de secretos.
VEC_CEPH_CLAVE_DERIVACION_BASE64URL=
VEC_CEPH_CIFRADO=AES256
VEC_CEPH_CLAVE_KMS=
VEC_CEPH_USAR_BUCKET_KEY_KMS=false
