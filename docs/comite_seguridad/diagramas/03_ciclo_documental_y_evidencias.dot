digraph ciclo_documental_seguro {
  graph [
    label="03 · CICLO DOCUMENTAL Y EVIDENCIAS\nAportación, generación, cuarentena, validación, firma, registro, cotejo y archivo",
    labelloc=t,
    labeljust=l,
    fontsize=22,
    fontname="DejaVu Sans",
    fontcolor="#162433",
    bgcolor="#FFFFFF",
    pad=0.30,
    nodesep=0.45,
    ranksep=0.58,
    rankdir=TB,
    newrank=true,
    compound=true,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=10,
    fontcolor="#162433",
    color="#5B6775",
    fillcolor="#F5F7FA",
    penwidth=1.35,
    margin="0.18,0.13"
  ];
  edge [
    fontname="DejaVu Sans",
    fontsize=9,
    fontcolor="#44515F",
    color="#667482",
    arrowsize=0.72,
    penwidth=1.15
  ];

  entrada_cerrada [
    color="#B33A3A", fillcolor="#FDEBEC", penwidth=1.8,
    label=<<FONT COLOR="#B33A3A" POINT-SIZE="9"><B>CERRADO A PRODUCCIÓN</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Las API documentales y el ejecutor atestado no se montan</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">Sin almacenamiento, antivirus, claves, persistencia y reconciliación homologados no se aceptan datos reales.</FONT>>
  ];

  subgraph cluster_origen {
    label="1 · ORIGEN DEL DOCUMENTO";
    color="#6F7F8F";
    fontcolor="#344454";
    fontname="DejaVu Sans";
    fontsize=12;
    style="rounded,dashed";
    penwidth=1.45;
    margin=20;

    aportado [
      color="#B7791F", fillcolor="#FFF4D6",
      label=<<FONT COLOR="#9A6317" POINT-SIZE="9"><B>PARCIAL · CONTRATOS</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Documento aportado</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">sesión de carga · referencia opaca · tamaño y huella esperados<BR ALIGN="LEFT"/>recibo de un solo uso; transporte productivo pendiente</FONT>>
    ];
    generado [
      color="#247A4D", fillcolor="#E7F4EC",
      label=<<FONT COLOR="#247A4D" POINT-SIZE="9"><B>IMPLEMENTADO · NÚCLEO LOCAL</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Documento generado</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">plantilla/version exactas · fusión literal · HMAC de datos<BR ALIGN="LEFT"/>PDF/DOCX deterministas · DocumentoLógico y representaciones</FONT>>
    ];
    ejecutor [
      color="#B7791F", fillcolor="#FFF4D6",
      label=<<FONT COLOR="#9A6317" POINT-SIZE="9"><B>PARCIAL · V4 EN SOMBRA</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Ejecución documental atestada</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">capacidades opacas, límites y recibos tipados;<BR ALIGN="LEFT"/>broker, aislamiento y pruebas criptográficas productivas pendientes</FONT>>
    ];

    generado -> ejecutor [label="plan exacto"];
  }

  subgraph cluster_ingesta {
    label="2 · INGESTA, CUARENTENA Y ANÁLISIS";
    color="#465B70";
    fontcolor="#283746";
    fontname="DejaVu Sans";
    fontsize=12;
    style="rounded,dashed";
    penwidth=1.55;
    margin=22;

    cuarentena [
      color="#B7791F", fillcolor="#FFF4D6",
      label=<<FONT COLOR="#9A6317" POINT-SIZE="9"><B>PARCIAL · MODELO Y PUERTOS</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Escritura temporal en cuarentena</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">flujo acotado · SHA-256 · tamaño · MIME · versión opaca<BR ALIGN="LEFT"/>adaptador actual en memoria, sin cifrado productivo</FONT>>
    ];
    analisis [
      color="#2F6B9A", fillcolor="#EAF2FB",
      label=<<FONT COLOR="#2F6B9A" POINT-SIZE="9"><B>OBJETIVO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Análisis independiente</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">antivirus corporativo · tipo real · estructura<BR ALIGN="LEFT"/>semántica · límites de expansión · evidencia verificable</FONT>>
    ];
    resultado [
      shape=diamond,
      style="filled",
      color="#5B6775", fillcolor="#F5F7FA",
      label="¿Resultado limpio,\nconcluyente y exacto?"
    ];
    retenido [
      color="#B33A3A", fillcolor="#FDEBEC",
      label=<<FONT COLOR="#B33A3A" POINT-SIZE="9"><B>CERRADO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Retenido / rechazado</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">malicioso · sospechoso · error · indeterminado<BR ALIGN="LEFT"/>sin descarga, firma, expediente ni promoción</FONT>>
    ];

    cuarentena -> analisis [label="lecturas acotadas"];
    analisis -> resultado;
    resultado -> retenido [label="NO / DUDA", color="#B33A3A"];
  }

  subgraph cluster_admision {
    label="3 · AUTORIZACIÓN, PROMOCIÓN Y CUSTODIA";
    color="#465B70";
    fontcolor="#283746";
    fontname="DejaVu Sans";
    fontsize=12;
    style="rounded,dashed";
    penwidth=1.55;
    margin=22;

    autorizacion [
      color="#B7791F", fillcolor="#FFF4D6",
      label=<<FONT COLOR="#9A6317" POINT-SIZE="9"><B>PARCIAL · NÚCLEO PROBADO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Nueva autorización exacta</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">actor · objeto/version · acción · finalidad · decisión vigente<BR ALIGN="LEFT"/>capacidad de un solo uso; barrera durable pendiente</FONT>>
    ];
    custodia [
      color="#2F6B9A", fillcolor="#EAF2FB",
      label=<<FONT COLOR="#2F6B9A" POINT-SIZE="9"><B>OBJETIVO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Promoción atómica a custodia</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">S3/filesystem cifrado · clave por objeto en KMS/HSM<BR ALIGN="LEFT"/>inmutabilidad · versionado · retención · bloqueo legal</FONT>>
    ];
    transaccion [
      color="#2F6B9A", fillcolor="#EAF2FB",
      label=<<FONT COLOR="#2F6B9A" POINT-SIZE="9"><B>OBJETIVO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Confirmación PostgreSQL</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">metadatos ENI + agregado + OCC + auditoría + outbox<BR ALIGN="LEFT"/>consumo de decisión en una sola transacción</FONT>>
    ];

    autorizacion -> custodia [label="promoción cercada"];
    custodia -> transaccion [label="referencia opaca"];
  }

  subgraph cluster_emision {
    label="4 · REVISIÓN, FIRMA Y EMISIÓN";
    color="#6F7F8F";
    fontcolor="#344454";
    fontname="DejaVu Sans";
    fontsize=12;
    style="rounded,dashed";
    penwidth=1.45;
    margin=20;

    revision [
      color="#2F6B9A", fillcolor="#EAF2FB",
      label=<<FONT COLOR="#2F6B9A" POINT-SIZE="9"><B>OBJETIVO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Revisión y preparación final</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">doble control cuando proceda · reservar CSV opaco<BR ALIGN="LEFT"/>incorporar URL + QR antes de la primera firma</FONT>>
    ];
    firma [
      color="#2F6B9A", fillcolor="#EAF2FB",
      label=<<FONT COLOR="#2F6B9A" POINT-SIZE="9"><B>OBJETIVO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Firma y validación</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">AutoFirma/DSS o sello HSM · revisiones inmutables<BR ALIGN="LEFT"/>OCSP/CRL · TSA · niveles PAdES LT/LTA según política</FONT>>
    ];
    emision [
      color="#2F6B9A", fillcolor="#EAF2FB",
      label=<<FONT COLOR="#2F6B9A" POINT-SIZE="9"><B>OBJETIVO</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13"><B>Emisión y conservación</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">registro · activar CSV · notificar · expediente/índice ENI<BR ALIGN="LEFT"/>archivo · retención · cotejo según clasificación</FONT>>
    ];

    revision -> firma [label="bytes congelados"];
    firma -> emision [label="validación final"];
  }

  aportado -> cuarentena [label="confirmación atestada"];
  ejecutor -> cuarentena [label="salida exacta"];
  entrada_cerrada -> aportado [style=dashed, color="#B33A3A", arrowhead=tee, constraint=false];
  resultado -> autorizacion [label="SÍ", color="#247A4D"];
  transaccion -> revision [label="documento admitido"];

  invariantes [
    shape=plain,
    margin=0,
    label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#AAB4BF">
      <TR><TD BGCOLOR="#F5F7FA"><B>INVARIANTES TRANSVERSALES</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Original, derivados, firmas e informes son objetos distintos e inmutables.<BR ALIGN="LEFT"/>Las referencias no contienen datos personales. Conocer una referencia no concede acceso.<BR ALIGN="LEFT"/>Cada lectura o cambio reautoriza y audita sin copiar contenido ni secretos a logs.</FONT></TD></TR>
    </TABLE>>
  ];

  leyenda [
    shape=plain,
    margin=0,
    label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#CBD2D9">
      <TR>
        <TD BGCOLOR="#E7F4EC"><FONT COLOR="#247A4D"><B>IMPLEMENTADO</B></FONT></TD>
        <TD BGCOLOR="#FFF4D6"><FONT COLOR="#9A6317"><B>PARCIAL</B></FONT></TD>
        <TD BGCOLOR="#EAF2FB"><FONT COLOR="#2F6B9A"><B>OBJETIVO</B></FONT></TD>
        <TD BGCOLOR="#FDEBEC"><FONT COLOR="#B33A3A"><B>CERRADO</B></FONT></TD>
      </TR>
    </TABLE>>
  ];
  { rank=sink; invariantes; leyenda; retenido; }
}
